# Data directories - exclude from version control
data/raw/*
data/processed/*
data/results/*
data/step_outputs/*

# Keep directory structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/results/.gitkeep
!data/step_outputs/.gitkeep

